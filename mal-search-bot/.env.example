# Copy this file to .env and fill in your bot's token.
# .env is git-ignored and should never be committed.
# If DISCORD_TOKEN is set here, it takes priority over token.yaml.

DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Optional: overrides for config.yaml settings.
# GUILD_ID=123456789012345678
# LOG_LEVEL=INFO
