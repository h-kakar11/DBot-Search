# Copy this file to .env and fill in your bot's token.
# .env is git-ignored and should never be committed.

# Required: your Discord bot token (Developer Portal -> Bot -> Reset Token).
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Optional: your development guild's ID, for instant slash-command sync while
# testing. Leave unset (or commented out) to sync commands globally instead.
# GUILD_ID=123456789012345678

# Optional: logging verbosity (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
# LOG_LEVEL=INFO

# Optional: Jikan API tuning (rarely needs to change from the defaults below).
# JIKAN_BASE_URL=https://api.jikan.moe/v4
# JIKAN_RATE_LIMIT_PER_SECOND=3
# JIKAN_RATE_LIMIT_PER_MINUTE=60
# JIKAN_MAX_RETRIES=3
